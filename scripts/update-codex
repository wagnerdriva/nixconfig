#!/usr/bin/env bash
set -euo pipefail

running_version=${1:?missing installed Codex version}
shift

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo 'Usage: codex update'
  echo 'Update the Nix pin and apply the current NixOS host configuration.'
  exit 0
fi
if (( $# != 0 )); then
  echo 'codex update takes no arguments' >&2
  exit 2
fi

repo=${CODEX_NIXOS_CONFIG:-$HOME/nixos-config}
host=${CODEX_NIXOS_HOST:-$(hostname)}
module=$repo/modules/home/development.nix

if [[ ! -f $module ]]; then
  echo "Codex Nix configuration not found: $module" >&2
  exit 1
fi
if [[ ! -e $repo/hosts/$host ]]; then
  echo "Unknown NixOS host '$host' in $repo" >&2
  exit 1
fi

current=$(sed -nE 's/^  codexVersion = "([0-9]+\.[0-9]+\.[0-9]+)";$/\1/p' "$module")
if [[ ! $current =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Could not read the Codex version from $module" >&2
  exit 1
fi

release=$(curl --fail --silent --show-error --location --retry 3 \
  https://api.github.com/repos/openai/codex/releases/latest | jq -er '.tag_name')
if [[ ! $release =~ ^rust-v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  echo "Unexpected Codex release tag: $release" >&2
  exit 1
fi
latest=${BASH_REMATCH[1]}

if [[ $(printf '%s\n' "$current" "$latest" | sort -V | tail -n 1) != "$latest" ]]; then
  echo "Pinned Codex $current is newer than published release $latest; leaving it unchanged." >&2
  exit 1
fi

pin_changed=false
if [[ $current != "$latest" ]]; then
  echo "Updating Codex pin from $current to $latest..."
  base=https://github.com/openai/codex/releases/download/$release
  cli_hash=$(nix store prefetch-file --json \
    "$base/codex-x86_64-unknown-linux-musl.tar.gz" | jq -er '.hash')
  host_hash=$(nix store prefetch-file --json \
    "$base/codex-code-mode-host-x86_64-unknown-linux-musl.tar.gz" | jq -er '.hash')
  if [[ ! $cli_hash =~ ^sha256-[A-Za-z0-9+/=]+$ || ! $host_hash =~ ^sha256-[A-Za-z0-9+/=]+$ ]]; then
    echo 'Received an invalid archive hash from Nix' >&2
    exit 1
  fi

  python3 - "$module" "$current" "$latest" "$cli_hash" "$host_hash" <<'PY'
import os
import pathlib
import re
import sys
import tempfile

path = pathlib.Path(sys.argv[1])
old_version, new_version, cli_hash, host_hash = sys.argv[2:]
content = path.read_text()
version_line = f'  codexVersion = "{old_version}";'
if content.count(version_line) != 1:
    raise SystemExit('Codex version changed while updating; retry the command')

start = content.index('  codex-package = ')
end = content.index('\n  orca-app = ', start)
package = content[start:end]
hashes = list(re.finditer(r'(?m)^        hash = "[^"]+";$', package))
if len(hashes) != 2:
    raise SystemExit('Expected exactly two Codex archive hashes')
for match, value in reversed(list(zip(hashes, (cli_hash, host_hash)))):
    package = package[:match.start()] + f'        hash = "{value}";' + package[match.end():]

updated = content[:start] + package + content[end:]
updated = updated.replace(version_line, f'  codexVersion = "{new_version}";', 1)
with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temp:
    temp.write(updated)
    temp_path = pathlib.Path(temp.name)
try:
    os.chmod(temp_path, path.stat().st_mode)
    os.replace(temp_path, path)
except BaseException:
    temp_path.unlink(missing_ok=True)
    raise
PY
  pin_changed=true
fi

if [[ $running_version == "$latest" && $pin_changed == false ]]; then
  echo "Codex $latest is already active."
  exit 0
fi

echo "Applying Codex $latest to $host (sudo may ask for your password)..."
sudo nixos-rebuild switch --flake "$repo#$host"
echo 'Codex updated. Run codex --version in a new shell to confirm.'
